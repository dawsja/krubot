# The address you open Kru Bot on. Must match what the browser uses.
APP_URL=http://localhost:3000
#KRU_PORT=3000

# Encrypts stored API keys and tokens. Optional: without it, the API creates
# secret.key in the data folder on first start. Losing the key makes stored
# secrets unreadable. Generate one with: openssl rand -base64 32
# KRU_SECRET_KEY=

# One-time token for registering the only account. Optional: without it, the
# API prints a random token in its logs while no account exists.
# KRU_SETUP_TOKEN=

# Session signing secret for login. Optional: derived from the secret key.
# BETTER_AUTH_SECRET=

# Composio: connected apps (Gmail, Slack, GitHub, Notion, Linear, …) for your
# bots. One project key from https://platform.composio.dev → Settings → API
# keys, starting with ak_. Optional: bots work without connected apps.
# COMPOSIO_API_KEY=
# Which toolkits the marketplace offers, comma-separated Composio slugs.
# COMPOSIO_TOOLKITS=gmail,googlecalendar,slack,github,notion,linear

# The box, where every bot has its computer. Set by docker-compose.yml.
# KRU_BOX_URL=http://box:8787
# KRU_BOX_TOKEN=

# How hard Claude Code thinks per reply: low, medium or high (unset: the
# CLI's default), and how long a bot's session may sit idle before it is
# closed, in milliseconds (on the box).
# KRU_BOT_EFFORT=
# BOT_IDLE_MS=600000

# How many bots may answer at once, and how long a pending approval waits
# before the bot is told it was not answered, in minutes.
# KRU_BOT_CONCURRENCY=3
# KRU_APPROVAL_TIMEOUT_MINUTES=30

# How long a task one bot handed to another may sit unanswered before the
# first bot nudges it, in minutes; after as long again, the wait is reported.
# KRU_NUDGE_MINUTES=120

# Where the box reaches the API. Your HTTP MCP servers are proxied through
# it, so their headers and secrets stay in the API. Set by docker-compose.yml.
# KRU_API_INTERNAL_URL=http://api:8790

# HTTP MCP servers that need a sign-in normally let Kru register itself as
# an OAuth client. A provider that only lets local tools sign in (Robinhood's
# Trading MCP) can send the sign-in back to http://localhost:47651/callback
# instead: pick localhost on the server in Settings; the desktop app finishes
# it, and in a browser you paste the address. For a provider that doesn't
# register clients at all, register one by hand with
# <APP_URL>/api/mcp-servers/oauth/callback as its redirect URL and set:
# KRU_MCP_CLIENT_ID=
# KRU_MCP_CLIENT_SECRET=

# Box resources.
# KRU_BOX_MEMORY=4g
# KRU_BOX_CPUS=2
# KRU_BOX_SHM=256m

# Settings → Computer → Update can pull the newest box image from GHCR and
# recreate the box. The API reaches Docker through /var/run/docker.sock
# (mounted in docker-compose.yml) and needs the socket's group id:
#   stat -c %g /var/run/docker.sock
# Without it, Update still patches the running box in place.
# KRU_DOCKER_GID=999
# KRU_DOCKER_SOCK=/var/run/docker.sock
