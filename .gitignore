# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.idea
.vscode
*.swp
soft

# keys and certs
*.pem
*.key
*.p12

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env and secrets — never commit real env or tokens
.env
.env.*
!.env.example

# local HQ store, sqlite, oauth tokens, GitHub App credentials
/data/
*.db
*.sqlite
*.sqlite3
kru.json
auth.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# locally installed agent skills (third-party); the shadcn ones are checked
# in under .agents/skills, and these links let Claude Code find them
/.claude/skills/
!/.claude/skills/shadcn
!/.claude/skills/migrate-radix-to-base
!/.claude/skills/better-auth-best-practices
!/.claude/skills/better-auth-security-best-practices
!/.claude/skills/create-auth
!/.claude/skills/email-and-password-best-practices
!/.claude/skills/organization-best-practices
!/.claude/skills/two-factor-authentication-best-practices

# lock file from locally installed agent skills
skills-lock.json

# workspace builds
apps/*/dist
packages/*/dist
apps/web/.next

# desktop app installers
apps/desktop/release
